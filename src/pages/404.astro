---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Seite nicht gefunden | Tor-Kaiser"
  description="Die aufgerufene Seite existiert leider nicht (mehr). Hier finden Sie zurück zum Hauptangebot."
  noindex={true}
>
  <section class="section">
    <div class="container-narrow not-found">
      <span class="eyebrow">Fehler 404</span>
      <h1>Diese Seite konnten wir leider nicht finden.</h1>
      <p class="lead">
        Vielleicht haben Sie sich vertippt, oder wir haben die Seite umgezogen. Kein Problem —
        hier finden Sie wieder rein:
      </p>

      <ul class="not-found-links">
        <li><a href="/">Startseite</a></li>
        <li><a href="/produkte/">Alle Produkte</a></li>
        <li><a href="/service/notdienst/">Notdienst</a></li>
        <li><a href="/kontakt/">Kontakt</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding-block: 2rem;
  }

  .not-found-links {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .not-found-links a {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    background: var(--color-brand);
    color: #fff;
    border-radius: 8px;
    font-weight: 600;
  }

  .not-found-links a:hover {
    background: var(--color-brand-dark);
    color: #fff;
  }
</style>
