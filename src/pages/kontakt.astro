---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { company, phoneHref, emailHref } from '../data/company';

const title = `Kontakt — Tor-Kaiser Gladbeck | Bauprojekt Kaiser GmbH`;
const description = `Verkaufsbüro und Service in der Bülser Straße 19, 45964 Gladbeck. Telefon ${company.contact.phone}, E-Mail ${company.contact.email}. Mo–Fr 9–14 Uhr.`;

const mapEmbedUrl = `https://www.openstreetmap.org/export/embed.html?bbox=6.97%2C51.56%2C7.00%2C51.58&layer=mapnik&marker=${company.address.latitude}%2C${company.address.longitude}`;
const mapsLink = `https://www.google.com/maps/place/${encodeURIComponent(
  `${company.address.street}, ${company.address.postalCode} ${company.address.city}`
)}`;
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs items={[{ label: 'Kontakt' }]} />

  <section class="section">
    <div class="container-wrap kontakt-grid">
      <div>
        <span class="eyebrow">Kontakt</span>
        <h1>Wir freuen uns auf Ihre Anfrage</h1>
        <p class="lead">
          Persönlich, telefonisch oder per E-Mail — Sie erreichen uns auf vielen Wegen. Für ein
          Aufmaß vor Ort vereinbaren wir gerne einen individuellen Termin.
        </p>

        <div class="kontakt-cards">
          <div class="card">
            <h2>📞 Telefon</h2>
            <p><a href={phoneHref}><strong>{company.contact.phone}</strong></a></p>
            <p class="muted">{company.openingHours.text}</p>
          </div>

          <div class="card">
            <h2>✉ E-Mail</h2>
            <p><a href={emailHref}><strong>{company.contact.email}</strong></a></p>
            <p class="muted">Antwort innerhalb eines Werktags</p>
          </div>

          <div class="card">
            <h2>🏢 Verkaufsbüro</h2>
            <p>
              <strong>{company.legalName}</strong><br />
              {company.address.street}<br />
              {company.address.postalCode} {company.address.city}
            </p>
            <p><a href={mapsLink} target="_blank" rel="noopener">In Google Maps öffnen ↗</a></p>
          </div>

          <div class="card emergency-card">
            <h2>🚨 Notdienst</h2>
            <p>
              <strong>{company.emergency.daytimeHours}</strong><br />
              <a href={`tel:${company.emergency.daytimePhoneE164}`}>{company.emergency.daytimePhone}</a>
            </p>
            <p>
              <strong>{company.emergency.nightHours}</strong><br />
              <a href={`tel:${company.emergency.nightPhoneE164}`}>{company.emergency.nightPhone}</a>
              <small>({company.emergency.nightNote})</small>
            </p>
          </div>
        </div>

        <div class="kontakt-extra">
          <h2>So erreichen Sie uns</h2>
          <p>
            Mit dem PKW: Ausfahrt Gladbeck-Mitte (B&nbsp;224) oder Gladbeck-Süd (A&nbsp;2). Vor
            unserem Verkaufsbüro stehen Parkplätze zur Verfügung.
          </p>
          <p>
            Mit dem ÖPNV: Mehrere Linien der Vestischen Straßenbahnen halten in fußläufiger
            Entfernung an der Bülser Straße.
          </p>
          <p>
            Fax: {company.contact.fax}<br />
            Handelsregister: {company.registration.hrb}, {company.registration.court}
          </p>
        </div>
      </div>

      <div class="kontakt-map">
        <iframe
          title="Standort Bauprojekt Kaiser GmbH in Gladbeck"
          src={mapEmbedUrl}
          loading="lazy"
          width="100%"
          height="400"
          style="border:0; border-radius:14px;"
        ></iframe>
        <p class="map-note">
          <a href={mapsLink} target="_blank" rel="noopener">Größere Karte öffnen (Google Maps) ↗</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .kontakt-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 960px) {
    .kontakt-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .kontakt-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 560px) {
    .kontakt-cards {
      grid-template-columns: 1fr;
    }
  }

  .kontakt-cards h2 {
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
  }

  .kontakt-cards .muted {
    color: var(--color-ink-muted);
    font-size: 0.88rem;
    margin: 0.5rem 0 0;
  }

  .emergency-card {
    background: rgba(198, 40, 40, 0.05);
    border-color: rgba(198, 40, 40, 0.25);
  }

  .emergency-card h2 {
    color: var(--color-danger);
  }

  .emergency-card small {
    display: block;
    color: var(--color-ink-muted);
    font-size: 0.8rem;
  }

  .kontakt-extra {
    margin-top: 2rem;
  }

  .kontakt-extra h2 {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
  }

  .map-note {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    text-align: right;
  }
</style>
