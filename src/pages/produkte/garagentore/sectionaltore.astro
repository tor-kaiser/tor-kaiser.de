---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Hero from '../../../components/Hero.astro';
import TrustBar from '../../../components/TrustBar.astro';
import CtaBlock from '../../../components/CtaBlock.astro';
import FAQ from '../../../components/FAQ.astro';
import ProductGallery from '../../../components/ProductGallery.astro';
import { productBySlug } from '../../../data/products';

const product = productBySlug('sectionaltore')!;

const title = 'Hörmann Garagen-Sectionaltore (LPU 67, RenoMatic) in Gladbeck | Tor-Kaiser';
const description =
  'Hörmann Garagen-Sectionaltore — LPU 67 Thermo, EPU 40, RenoMatic. Wärmegedämmt, sicher, platzsparend. Beratung, Lieferung und Montage in Gladbeck, Bottrop, Gelsenkirchen, Essen.';

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Hörmann Garagen-Sectionaltor',
  brand: { '@type': 'Brand', name: 'Hörmann' },
  category: 'Garagentor',
  description,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: '1500',
    highPrice: '5500',
    availability: 'https://schema.org/InStock',
    seller: { '@id': 'https://tor-kaiser.de/#organization' },
  },
};

const faqs = [
  {
    question: 'Was ist der Unterschied zwischen LPU 42 und LPU 67?',
    answer:
      'Die Zahl steht für die Lamellendicke in Millimetern. LPU 42 hat 42 mm wärmegedämmte Doppelwand-Sandwich-Lamellen. LPU 67 erhöht die Dicke auf 67 mm und gilt aktuell als bestes serienmäßiges Garagen-Sectionaltor in puncto Wärmedämmung (U-Wert bis 1,0 W/m²K inkl. ThermoFrame).',
  },
  {
    question: 'Kann das Sectionaltor in Sonderfarben lackiert werden?',
    answer:
      'Ja. Hörmann bietet alle RAL-Farben sowie zahlreiche DecoColor- und Holzdekor-Oberflächen (z. B. Decograin). Standard ist Verkehrsweiß RAL 9016 — beliebt sind Anthrazit RAL 7016, Schwarzbraun RAL 8022 sowie Holzdekore wie Night Oak und Golden Oak.',
  },
  {
    question: 'Welche Größen sind möglich?',
    answer:
      'Standard-Sectionaltore reichen von 2.000 bis 5.000 mm Breite und bis 3.000 mm Höhe. Sondermaße sind möglich, sollten aber beim Aufmaß individuell besprochen werden.',
  },
  {
    question: 'Brauche ich einen elektrischen Antrieb?',
    answer:
      'Sectionaltore sind sowohl manuell als auch mit Antrieb (Hörmann SupraMatic oder ProMatic) lieferbar. Wir empfehlen für den täglichen Gebrauch einen Antrieb mit BiSecur-Funk — es erhöht den Komfort und die Sicherheit deutlich.',
  },
  {
    question: 'Was kostet ein Hörmann Sectionaltor inkl. Montage?',
    answer:
      'Ein RenoMatic-Tor ab Lager beginnt bei rund 1.700 € inkl. Antrieb (Sondermaße zzgl.). Ein LPU 67 Thermo-Tor in Sonderausstattung liegt typischerweise zwischen 3.500 und 5.500 €. Montage und Anlieferung in Gladbeck und Umgebung kalkulieren wir nach Aufmaß.',
  },
];
---

<BaseLayout title={title} description={description} schema={productSchema}>
  <Breadcrumbs items={[
    { label: 'Produkte', href: '/produkte/' },
    { label: 'Garagentore', href: '/produkte/garagentore/' },
    { label: 'Sectionaltore' },
  ]} />

  <Hero
    eyebrow="Hörmann Garagentor"
    title="Sectionaltore — der Standard für moderne Garagen"
    subtitle="Senkrecht öffnend, platzsparend unter der Decke und mit bester Wärmedämmung. Sectionaltore sind die meistverkaufte Hörmann-Bauart — aus gutem Grund."
    image={product.image}
    imageAlt={product.imageAlt}
    primaryCta={{ label: 'Aufmaß anfordern', href: '/anfrage/' }}
  />

  <TrustBar />

  <section class="section">
    <div class="container-wrap prose-content">
      <h2>Was zeichnet das Hörmann Sectionaltor aus?</h2>
      <p>
        Ein Sectionaltor besteht aus mehreren horizontalen Lamellen, die senkrecht nach oben
        öffnen und sich anschließend platzsparend unter die Garagendecke legen. Vor der Garage
        bleibt kein Schwenkbereich frei — Sie können also bis dicht an das Tor heranfahren.
        Auch die Garagentiefe bleibt voll nutzbar, im Gegensatz zum Schwingtor.
      </p>

      <h2>Modell-Übersicht</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>Modell</th>
            <th>Lamelle</th>
            <th>U-Wert</th>
            <th>Besonderheiten</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>RenoMatic</strong></td>
            <td>42 mm</td>
            <td>~1,3 W/m²K</td>
            <td>Lagerprogramm — schnell verfügbar, gutes Preis-Leistungs-Verhältnis</td>
          </tr>
          <tr>
            <td><strong>LPU 42</strong></td>
            <td>42 mm</td>
            <td>1,1 W/m²K</td>
            <td>Klassiker, viele Farben/Sicken/Designs</td>
          </tr>
          <tr>
            <td><strong>LPU 67 Thermo</strong></td>
            <td>67 mm</td>
            <td>0,9 W/m²K *</td>
            <td>Höchste Wärmedämmung im Standardprogramm</td>
          </tr>
          <tr>
            <td><strong>EPU 40</strong></td>
            <td>40 mm</td>
            <td>~1,4 W/m²K</td>
            <td>Garagen-Tor für Tiefgaragen / unbeheizt</td>
          </tr>
          <tr>
            <td><strong>LTH 40</strong></td>
            <td>40 mm</td>
            <td>~1,4 W/m²K</td>
            <td>Holzfüllung in Hemlock/Meranti — natürliche Optik</td>
          </tr>
        </tbody>
      </table>
      <p><small>* in Kombination mit ThermoFrame Zarge.</small></p>

      <h2>Vorteile auf einen Blick</h2>
      <ul>
        <li><strong>Fingerklemmschutz</strong> serienmäßig innen und außen</li>
        <li><strong>Seilbruchsicherung</strong> verhindert Absturz</li>
        <li><strong>Hörmann ThermoFrame</strong> dichtere Zarge mit Wärmedämmung</li>
        <li><strong>Über 200 Farben und Oberflächen</strong> (Standard, DecoColor, Decograin, RAL nach Wahl)</li>
        <li><strong>SupraMatic / ProMatic Antrieb</strong> mit BiSecur-Funk (AES-128)</li>
        <li><strong>Smart-Home-fähig</strong> via Hörmann homee oder Bluetooth Low Energy</li>
      </ul>

      <h2>Designs & Oberflächen</h2>
      <p>
        Sectionaltore bekommen Sie in Sicken (Standard, glatte Oberfläche „PlanoMatic“, Kassetten,
        Sicken vertikal oder horizontal), in Aluminium-Rahmen-Optik (ALR) oder mit Holzfüllung
        (LTH). Beliebte Decograin-Oberflächen: Night Oak, Golden Oak, Titan Metallic CH 703,
        Decograin White Aluminium.
      </p>

      <h2>Sicherheit</h2>
      <p>
        Sectionaltore von Hörmann erfüllen die Norm EN 13241. Serienmäßige Sicherheits-Features:
        Fingerklemmschutz an allen Lamellenstößen und an den Seitenführungen, Seilbruchsicherung,
        eingebaute Aufhebelsicherung an der Antriebsseite und Kraftbegrenzung an automatischen
        Antrieben.
      </p>

      <h2>Antrieb & Smart Home</h2>
      <p>
        Wir empfehlen für jeden Neukauf einen Hörmann <strong>SupraMatic E&nbsp;4</strong> oder
        <strong>ProMatic 4</strong>. Beide Modelle sind mit BiSecur-Funk ausgestattet, der nicht
        nur abhörsicher (AES&nbsp;128-Bit), sondern auch bidirektional ist: Sie sehen am
        Handsender, ob das Tor offen oder geschlossen ist.
      </p>

      <h2>Ablauf bei uns</h2>
      <ol>
        <li>Telefonische Erstberatung in unserer Sprechzeit Mo–Fr 9–14 Uhr.</li>
        <li>Kostenloser Aufmaß-Termin bei Ihnen vor Ort.</li>
        <li>Verbindliches Festpreis-Angebot mit Lieferzeit.</li>
        <li>Anlieferung und Montage durch unsere festen Partnerbetriebe — meist an einem Werktag.</li>
        <li>Einweisung und Hörmann-Garantie.</li>
      </ol>
    </div>
  </section>

  <ProductGallery product={product} heading="Sectionaltor-Designs in der Übersicht" />

  <FAQ items={faqs} />

  <CtaBlock />
</BaseLayout>
