---
import type { Product } from '../data/products';

interface Props {
  product: Product;
  heading?: string;
}

const { product, heading = 'Bildergalerie' } = Astro.props;
const gallery = product.gallery ?? [];

function webpFromJpg(src: string): string {
  return src.replace(/\.jpe?g$/i, '.webp');
}
---

{
  gallery.length > 0 && (
    <section class="container-wrap product-gallery">
      <h2>{heading}</h2>
      <div class="gallery-grid">
        {gallery.map((img) => (
          <figure class="gallery-item">
            <picture>
              <source srcset={webpFromJpg(img.src)} type="image/webp" />
              <img src={img.src} alt={img.alt} loading="lazy" width="800" height="560" />
            </picture>
            <figcaption>{img.alt}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  .product-gallery {
    margin-block: clamp(2.5rem, 6vw, 4rem);
  }

  .product-gallery h2 {
    margin-bottom: 1.5rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .gallery-item {
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
  }

  .gallery-item picture {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-alt);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.03);
  }

  .gallery-item figcaption {
    padding: 0.75rem 1rem 1rem;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    line-height: 1.4;
  }
</style>
