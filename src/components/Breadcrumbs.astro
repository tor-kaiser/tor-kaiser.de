---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const siteUrl = 'https://tor-kaiser.de';
const trailWithHome: Crumb[] = [{ label: 'Startseite', href: '/' }, ...items];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trailWithHome.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, siteUrl).toString() } : {}),
  })),
};
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container-wrap">
    <ol>
      {
        trailWithHome.map((c, i) => (
          <li>
            {c.href && i < trailWithHome.length - 1 ? (
              <a href={c.href}>{c.label}</a>
            ) : (
              <span aria-current="page">{c.label}</span>
            )}
            {i < trailWithHome.length - 1 && <span class="sep">›</span>}
          </li>
        ))
      }
    </ol>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</nav>

<style>
  .breadcrumbs {
    background: var(--color-surface-alt);
    padding-block: 0.75rem;
    font-size: 0.88rem;
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--color-ink-muted);
  }

  .breadcrumbs a {
    color: var(--color-ink-muted);
  }

  .breadcrumbs a:hover {
    color: var(--color-brand);
  }

  .breadcrumbs .sep {
    margin-inline: 0.4rem;
    color: var(--color-ink-muted);
  }

  .breadcrumbs span[aria-current='page'] {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
