---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;

function webpFromJpg(src: string): string {
  return src.replace(/\.jpe?g$/i, '.webp');
}

const webpSrc = product.image && /\.jpe?g$/i.test(product.image) ? webpFromJpg(product.image) : null;

const cardImageStyle =
  product.imageFit || product.imagePosition || product.imageBackground
    ? `--card-image-fit:${product.imageFit ?? 'cover'};--card-image-position:${product.imagePosition ?? 'center'};${product.imageBackground ? `--card-image-background:${product.imageBackground};` : ''}`
    : undefined;
---

<a href={product.href} class="product-card card card-interactive">
  {
    product.image && (
      <div class="card-image" style={cardImageStyle}>
        <picture>
          {webpSrc && <source srcset={webpSrc} type="image/webp" />}
          <img src={product.image} alt={product.imageAlt ?? product.title} loading="lazy" width="400" height="280" />
        </picture>
      </div>
    )
  }
  <div class="card-body">
    <h3>{product.shortTitle}</h3>
    <p class="card-tagline">{product.tagline}</p>
    <p class="card-desc">{product.description}</p>
    <span class="card-link">Mehr erfahren →</span>
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    color: var(--color-ink);
    height: 100%;
  }

  .card-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--card-image-background, var(--color-surface-alt));
  }

  .card-image picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: var(--card-image-fit, cover);
    object-position: var(--card-image-position, center);
    transition: transform 0.4s ease;
    display: block;
  }

  .product-card:hover .card-image img {
    transform: scale(1.04);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-body h3 {
    margin: 0 0 0.4rem;
    font-size: 1.25rem;
  }

  .card-tagline {
    color: var(--color-brand);
    font-weight: 600;
    font-size: 0.92rem;
    margin: 0 0 0.75rem;
  }

  .card-desc {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 1rem;
    flex: 1;
  }

  .card-link {
    color: var(--color-brand);
    font-weight: 700;
    margin-top: auto;
  }
</style>
