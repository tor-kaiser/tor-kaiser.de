---
const references = [
  {
    name: 'IKEA Einrichtungshaus',
    location: 'Dortmund',
    scope: 'Industrie-Sectionaltore & Schnelllauftore für Anlieferzonen',
  },
  {
    name: 'Sparkasse',
    location: 'Wuppertal',
    scope: 'Hochwertige Eingangstüren und Garagentore',
  },
  {
    name: 'Oberlandesgericht (OLG)',
    location: 'Essen',
    scope: 'Sicherheits-Eingangstüren und Industrie-Sectionaltore',
  },
  {
    name: 'Logistikbetriebe',
    location: 'Bottrop & Gelsenkirchen',
    scope: 'Schnelllauftore und Industrie-Rolltore',
  },
  {
    name: 'Wohnungsbaugesellschaften',
    location: 'Vest Recklinghausen',
    scope: 'Garagentor-Sanierung in größeren Wohnanlagen',
  },
  {
    name: 'Privatkunden',
    location: 'Gladbeck und Umgebung',
    scope: 'Garagentore, Haustüren und Antriebe',
  },
];
---

<section class="references">
  <div class="container-wrap">
    <div class="references-head">
      <span class="eyebrow">Referenzen</span>
      <h2>Vertrauen, das Spuren hinterlässt</h2>
      <p class="lead">
        Vom Einfamilienhaus bis zum Industriekomplex: Bauprojekt Kaiser steht seit Jahrzehnten für
        zuverlässige Hörmann-Lösungen — privat, gewerblich und öffentlich.
      </p>
    </div>
    <div class="references-grid">
      {
        references.map((r) => (
          <div class="reference-card card">
            <h3>{r.name}</h3>
            <p class="reference-location">{r.location}</p>
            <p class="reference-scope">{r.scope}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .references {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .references-head {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .references-head .lead {
    margin-inline: auto;
    margin-top: 0.5rem;
  }

  .references-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.25rem;
  }

  .reference-card {
    text-align: left;
  }

  .reference-card h3 {
    font-size: 1.1rem;
    color: var(--color-brand);
    margin: 0 0 0.25rem;
  }

  .reference-location {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 0.75rem;
  }

  .reference-scope {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    margin: 0;
  }
</style>
